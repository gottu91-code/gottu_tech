---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import mainVisual from '@images/main_visual.jpg'
import bobo from '@images/bobo.jpg'
import kakkosan from '@images/kakkosan.jpg'
import aOfficeMiyakojima from '@images/a-office-miyakojima.jpg'
import azamiannShirahama from '@images/azamiann-shirahama.jpg'
import azamiRentalcar from '@images/azami-rentalcar.jpg'
import casualStayAguncha from '@images/casual_stay_aguncha.jpg'
import hillsVillaMiyako from '@images/hills_villa_miyako_lp.jpg'
import rush from '@images/rush.jpg'
import azamiWeekly from '@images/azami-weekly.jpg'
import aidemy from '@images/aidemy.jpg'
import simplex from '@images/simplex.jpg'
import recruitAzamigroup from '@images/recruit-azamigroup.jpg'
import ExternalLinkIcon from '@images/ExternalLinkIcon.astro';
import SecBlog from '@components/SecBlog.astro';
---

<Layout title="">
  <div class="wrap_inner">
    <section class="sec_main_visual" id="sec_main_visual">
      <div class="main_visual_inner">
        <div class="main_visual">
          <Image
            src={mainVisual}
            alt='日が差している部屋'
            class="image"
          />
          <div class="mask"></div>
          <h1>
            現場の“面倒くさい”を、問いとWebでほどく。<br>
            働く人と会社に余裕と安心をつくる、<br>
            Web制作・Webシステム開発を行っています。
          </h1>
        </div>
      </div>
    </section>

    <section class="sec_services" id="sec_services">
      <div class="sec_container">
        <div class="title_box">
          <h2>Services</h2>
        </div>

        <div class="sec_box">
          <p class="text">
            1. Webサイト制作<br>
            2. Webシステム開発<br>
            3. 管理画面開発<br>
            4. 業務改善<br>
            5. 情報整理<br>
            6. DX支援<br>
            7. AI導入<br>
          </p>
        </div>
      </div>
    </section>

    <section class="sec_concept" id="sec_concept">
      <div class="sec_container">
        <div class="title_box">
          <h2>Concept</h2>
        </div>

        <div class="sec_box">
          <p class="text">
            現場の“面倒くさい”を、問いとWebでほどく。<br>
            <br>
            Webサイト制作やWebシステム開発を通じて、現場のムダな作業、属人化、確認漏れ、情報共有のズレを整理し、働く人と会社に余裕をつくることを目指しています。<br>
            <br>
            いきなり作るのではなく、まず現場の声を聞き、業務の流れを理解することを大切にしています。<br>
          </p>
        </div>
      </div>
    </section>

    <section class="sec_mvv" id="sec_mvv">
      <div class="sec_container">
        <div class="title_box">
          <h2>MVV</h2>
        </div>

        <div class="sec_box">
          <div class="section_group">
            <section class="section_group_item">
              <h3>▼ Mission</h3>
              <p class="text">
                仕事で人がすり減らない仕組みを作る。
              </p>
            </section>

            <section class="section_group_item">
              <h3>▼ Vision</h3>
              <p class="text">
                働く人とその家族の毎日に、余裕と安心を増やす。
              </p>
            </section>

            <section class="section_group_item">
              <h3>▼ Value</h3>
              <p class="text">
                目的を問い、現場に向き合い、変わりたい人と誠実に仕組みを整える。
              </p>
            </section>
          </div>
        </div>
      </div>
    </section>

    <section class="sec_message" id="sec_message">
      <div class="sec_container">
        <div class="title_box">
          <h2>Message</h2>
        </div>

        <div class="sec_box">
          <div class="text_group">
            <p class="text">
              仕事は、生活を削るためではなく、生活を支えるためにあるものだと思っています。
            </p>
            <p class="text">
              しかし実際の現場では、ムダな手作業、二重入力、属人化、確認漏れ、情報の分散などによって、働く人の時間や心身の余裕が少しずつ削られていることがあります。
            </p>
            <p class="text">
              私は、そうした現場の負担を「もっと頑張る」ことで解決するのではなく、業務の流れや仕組みを整えることで軽くしたいと考えています。
            </p>
            <p class="text">
              人の努力や注意力に頼りすぎず、無理なく回る仕組みを作ること。<br>
              現場の人と同じ方向を向き、課題を一緒に見つめること。<br>
              そして、作って終わりではなく、運用しながら改善を積み重ねること。
            </p>
            <p class="text">
              それが、私の考えるWeb制作・Webシステム開発です。
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="sec_why_how_what" id="sec_why_how_what">
      <div class="sec_container">
        <div class="title_box">
          <h2>Why / How / What</h2>
        </div>

        <div class="sec_box">
          <div class="section_group">
            <section class="section_group_item">
              <h3>▼ Why</h3>
              <div class="text_group">
                <p class="text">
                  仕事で人がすり減らない現場を増やしたい。
                </p>
                <p class="text">
                  働く人がムダな作業や情報共有のズレに消耗されず、本来の仕事に集中できる状態を作りたいと考えています。
                </p>
              </div>
            </section>

            <section class="section_group_item">
              <h3>▼ How</h3>
              <div class="text_group">
                <p class="text">
                  現場に足を運び、担当者の声を聞き、問いながら業務の流れや課題を整理します。
                </p>
                <p class="text">
                  そのうえで、Webサイト、管理画面、業務システム、自動化など、必要な形に落とし込みます。
                </p>
                <p class="text">
                  何でもシステム化すれば良いとは考えていません。<br>
                  今のやり方に意味があるなら尊重し、変えたい部分・負担になっている部分を必要な分だけ整えます。
                </p>
              </div>
            </section>

            <section class="section_group_item">
              <h3>▼ What</h3>
              <div class="text_group">
                <p class="text">
                  Webサイト制作、Webシステム開発、管理画面開発、業務改善、DX支援を行っています。
                </p>
                <p class="text">
                  特に、紙・Excel・メール・電話などに分散した情報の整理、二重入力の削減、属人化の解消、問い合わせ・予約・顧客管理まわりの効率化を得意としています。
                </p>
              </div>
            </section>
          </div>
        </div>
      </div>
    </section>

